# GuardrailOps Environment Variables
# Copy this file to .env and fill in your values

# Slack Incoming Webhook URL (for real-time Slack Block Kit alert cards)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL

# Local Meta Llama Guard 3 Ollama Endpoint (default: http://localhost:11434)
LLAMA_GUARD_ENDPOINT=http://localhost:11434

# NVIDIA NIM / Cloud Llama Guard API Key (Optional)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# OpenTelemetry Collector Endpoint (default for local Docker setup)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for OTel traces
OTEL_SERVICE_NAME=guardrailops-demo

# OpenAI API Key (Optional — only if using openai-moderation or OpenAI completions)
# OPENAI_API_KEY=sk-your-openai-api-key-here
