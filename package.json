{
  "name": "guardrailops",
  "version": "1.0.0",
  "description": "A SigNoz-native AI Safety & Incident Response System for Node.js/TypeScript. Detects jailbreaks, protects crisis users, scrubs PII, and pages on-call SREs via Slack — all traced with OpenTelemetry.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch demo-app/server.ts",
    "typecheck": "tsc --noEmit",
    "test:attack": "tsx scripts/attack-simulate.ts",
    "start:demo": "tsx demo-app/server.ts",
    "start:relay": "tsx webhook-relay/server.ts",
    "start:bot": "tsx slack-bot/bot.ts"
  },
  "keywords": [
    "guardrails",
    "ai-safety",
    "opentelemetry",
    "signoz",
    "llm",
    "jailbreak-detection",
    "mental-health",
    "crisis-detection",
    "mcp",
    "observability"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@types/express": "^4.17.21",
    "express": "^4.19.0",
    "openai": "^4.55.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
